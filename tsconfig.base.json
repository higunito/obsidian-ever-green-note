{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"@web/*": ["apps/web/src/*"],
			"@schema": ["packages/content-schema/src/index.ts"],
			"@schema/*": ["packages/content-schema/src/*"],
			"@content-gen": ["packages/content-gen/src/index.ts"],
			"@content-gen/*": ["packages/content-gen/src/*"]
		}
	}
}
